# Copy to .env and fill in. .env is gitignored — never commit a key.
#
# Rehearse on testnet first. The same script, one word different, with
# free coins from a faucet. A launch you have already done once is a very
# different thing from one you are doing for the first time with money.

NETWORK=testnet
# NETWORK=mainnet

# Testnet RPC (get test BNB from a BNB Chain faucet)
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Mainnet RPC
# RPC_URL=https://bsc-dataseed.bnbchain.org

# Deployer key. Use a wallet created FOR this launch, holding only the BNB
# the launch needs. Never paste a key that also holds funds you care about.
PRIVATE_KEY=

# Receives the entire 1,000,000,000 CPU supply at deployment.
TREASURY_ADDRESS=

# --- Optional: reward distributor -------------------------------------
# Leave REWARD_TOKEN_ADDRESS empty to deploy only the token.
# Confirm any address here on the explorer before using it; the launcher
# checks that contract code exists at it, but cannot check it is the
# token you meant.
REWARD_TOKEN_ADDRESS=
# Defaults to the deployer if unset.
DISTRIBUTOR_OWNER=

# --- Optional: automatic source verification ---------------------------
# Without a key the launcher still writes a verification bundle you can
# paste into the explorer by hand.
BSCSCAN_API_KEY=
BSCSCAN_API_URL=https://api.etherscan.io/v2/api
